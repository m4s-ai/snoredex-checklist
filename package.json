{
  "name": "snoredex-checklist",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "=26.7.0",
    "npm": "=11.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "check": "npm run typecheck && npm test && npm run smoke",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/catalogue-validator.test.ts",
    "smoke": "node tests/toolchain-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2"
  }
}
